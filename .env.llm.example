# Copy values to a private .env.llm.local file; never commit credentials.
# loadEnv() does not execute substitutions, and existing environment wins.
# IDs: minimax, deepseek, glm, glm-vision, custom. These are independent profiles.
EOTS_LLM_MINIMAX_API_KEY=
EOTS_LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
EOTS_LLM_MINIMAX_MODEL=MiniMax-M3
EOTS_LLM_MINIMAX_VISION=false
# Stable M3 supports disabled thinking; M2.x cannot disable thinking.
EOTS_LLM_MINIMAX_EXTRA_BODY='{"thinking":{"type":"disabled"},"reasoning_split":true}'

EOTS_LLM_DEEPSEEK_API_KEY=
EOTS_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
EOTS_LLM_DEEPSEEK_MODEL=deepseek-flash
EOTS_LLM_DEEPSEEK_VISION=false
EOTS_LLM_DEEPSEEK_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# Only enable JSON mode when prompts explicitly instruct JSON output.
EOTS_LLM_DEEPSEEK_JSON_MODE=false

EOTS_LLM_GLM_API_KEY=
EOTS_LLM_GLM_BASE_URL=https://api.z.ai/api/paas/v4
EOTS_LLM_GLM_MODEL=glm-5.3
EOTS_LLM_GLM_VISION=false
# GLM-5.3 requires thinking enabled; disabled returns an API error.
EOTS_LLM_GLM_EXTRA_BODY='{"thinking":{"type":"enabled"},"reasoning_effort":"low"}'
EOTS_LLM_GLM_JSON_MODE=false

# Shares EOTS_LLM_GLM_API_KEY unless a GLM_VISION_API_KEY is explicitly set.
EOTS_LLM_GLM_VISION_BASE_URL=https://api.z.ai/api/paas/v4
EOTS_LLM_GLM_VISION_MODEL=glm-4.6v
EOTS_LLM_GLM_VISION_VISION=true
# Capability must be declared explicitly; MODEL never auto-enables images.
EOTS_LLM_GLM_VISION_EXTRA_BODY='{}'

# Custom OpenAI-compatible deployment. HTTPS is required except loopback HTTP.
# BASE_URL may already end in /v1 or /chat/completions.
EOTS_LLM_PROVIDER=openai-compatible
EOTS_LLM_BASE_URL=
EOTS_LLM_MODEL=
EOTS_LLM_API_KEY=
EOTS_LLM_VISION=false
EOTS_LLM_EXTRA_BODY='{}'
EOTS_LLM_JSON_MODE=false
EOTS_LLM_JSON_SUPPORTED=false

# Per-profile TIMEOUT_MS/MAX_TOKENS override these shared defaults.
EOTS_LLM_TIMEOUT_MS=30000
EOTS_LLM_MAX_TOKENS=4096
# EXTRA_BODY allows only thinking, reasoning_effort, reasoning_split,
# response_format and top_p; it cannot override messages/model/token limits.
# Standard key aliases: MINIMAX_API_KEY, DEEPSEEK_API_KEY, GLM_API_KEY,
# ZAI_API_KEY. Explicit EOTS values (including empty values) take precedence.
# Official model/endpoint references checked 2026-10-05:
# https://platform.minimax.io/docs/api-reference/text-openai-api
# https://api-docs.deepseek.com/api/create-chat-completion/
# https://docs.z.ai/guides/llm/glm-5.3
# https://docs.z.ai/guides/vlm/glm-4.6v
