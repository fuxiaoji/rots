{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eots.local/schema/erasmus-page-v2.json",
  "type": "object",
  "required": ["schema_version", "chart_id", "role", "phase", "kind", "source", "nodes", "qa"],
  "properties": {
    "schema_version": { "const": 2 },
    "chart_id": { "type": "string", "pattern": "^ERASMUS-(JP|AP)-[0-9]{2}$" },
    "role": { "enum": ["Japan", "Allies"] },
    "phase": { "enum": ["early", "middle", "end", "all"] },
    "kind": { "enum": ["decision-axis", "card-selection", "task-force", "reaction"] },
    "source": { "type": "object", "required": ["pdf", "page", "markdown"] },
    "nodes": { "type": "array", "minItems": 3, "items": {
      "type": "object",
      "required": ["id", "type", "confidence", "source_page"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["start", "condition", "priority", "action", "dice", "terminal", "fallback"] },
        "confidence": { "enum": ["confirmed", "inferred"] },
        "source_page": { "type": "integer", "minimum": 1, "maximum": 12 },
        "edges": { "type": "array", "items": { "type": "object", "required": ["when", "to"] } }
      }
    } },
    "qa": { "type": "object", "required": ["inferred_nodes", "visual_review_required"] }
  }
}
